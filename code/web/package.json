{
  "name": "@quiescent/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && bun run dev:writing",
    "build": "astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "bash ../../scripts/writing-deploy.sh",
    "typecheck": "astro check",
    "test:e2e": "node ../../scripts/test-browser.mjs",
    "test:e2e:ui": "node ../../scripts/test-browser.mjs --ui"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "@quiescent/editor": "workspace:*",
    "@quiescent/git": "workspace:*",
    "@quiescent/server": "workspace:*",
    "astro": "^7.3.5",
    "@quiescent/astro": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@playwright/test": "1.59.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.144.0"
  }
}
