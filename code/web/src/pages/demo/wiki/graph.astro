---
import Layout from "../../../layouts/Layout.astro";

export const prerender = false;
---

<Layout title="Wiki graph">
  <p><a href="/demo/wiki">← wiki</a></p>
  <h1>Graph</h1>
  <p class="lead">
    Notes joined by resolved wikilinks; toggle tags to see the Obsidian-style
    view where tags are nodes too. Click a node to open the note.
  </p>
  <label><input type="checkbox" id="show-tags" data-testid="toggle-tags" /> show tags</label>
  <div id="graph" data-testid="graph"></div>
</Layout>

<script>
  import type { WikiGraph } from "@quiescent/wiki";
  import { mountWikiGraph, type WikiGraphView } from "@quiescent/wiki/client";

  const container = document.getElementById("graph") as HTMLElement;
  const toggle = document.getElementById("show-tags") as HTMLInputElement;
  const graph: WikiGraph = await (await fetch("/api/demo/wiki/graph.json")).json();

  let view: WikiGraphView = mountWikiGraph(container, graph, { showTags: toggle.checked });
  container.dataset.nodes = String(graph.nodes.filter((n) => n.kind === "note").length);
  container.dataset.ready = "true";

  toggle.addEventListener("change", () => {
    view.destroy();
    view = mountWikiGraph(container, graph, { showTags: toggle.checked });
    container.dataset.nodes = String(
      toggle.checked ? graph.nodes.length : graph.nodes.filter((n) => n.kind === "note").length,
    );
  });
</script>

<style>
  #graph {
    height: 65vh;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-radius: 4px;
    margin-top: 0.5rem;
  }
</style>
