---
import { notes } from "virtual:quiescent-wiki";
import Layout from "../../../layouts/Layout.astro";

export const prerender = false;

const groups = new Map<string, typeof notes>();
for (const note of notes) {
  const key = note.type ?? "other";
  groups.set(key, [...(groups.get(key) ?? []), note]);
}
const sections = [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<Layout title="Wiki demo">
  <p><a href="/demo">← demos</a></p>
  <h1>Wiki</h1>
  <p class="lead">
    {notes.length} notes ·
    <a href="/demo/wiki/search" data-testid="nav-search">search</a> ·
    <a href="/demo/wiki/tags" data-testid="nav-tags">tags</a> ·
    <a href="/demo/wiki/graph" data-testid="nav-graph">graph</a>
  </p>

  {
    sections.map(([type, group]) => (
      <section>
        <h2>{type}</h2>
        <ul class="notes">
          {group
            .sort((a, b) => (a.title ?? a.basename).localeCompare(b.title ?? b.basename))
            .map((note) => (
              <li>
                <a href={note.url} data-testid="note-link">
                  {note.title ?? note.basename}
                </a>
                {note.status && <span class="status">{note.status}</span>}
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Layout>

<style>
  .notes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .status {
    font-size: 0.75rem;
    opacity: 0.6;
    margin-left: 0.5rem;
  }
</style>
