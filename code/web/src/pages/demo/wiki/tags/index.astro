---
import { tags } from "virtual:quiescent-wiki";
import Layout from "../../../../layouts/Layout.astro";

export const prerender = false;

// Hierarchical `namespace/value` tags, grouped by namespace for browsing.
const namespaces = new Map<string, Array<[string, number]>>();
for (const [tag, notes] of Object.entries(tags)) {
  const ns = tag.includes("/") ? tag.split("/")[0]! : "other";
  namespaces.set(ns, [...(namespaces.get(ns) ?? []), [tag, notes.length]]);
}
const sections = [...namespaces.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<Layout title="Wiki tags">
  <p><a href="/demo/wiki">← wiki</a></p>
  <h1>Tags</h1>
  {
    sections.map(([ns, entries]) => (
      <section>
        <h2>{ns}</h2>
        <ul class="tags">
          {entries.map(([tag, count]) => (
            <li>
              <a href={`/demo/wiki/tags/${tag}`} data-testid="tag-link">
                {tag}
              </a>
              <span class="count">{count}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>

<style>
  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .count {
    opacity: 0.6;
    font-size: 0.8rem;
    margin-left: 0.3rem;
  }
</style>
