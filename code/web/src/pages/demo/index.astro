---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="quiescent demos">
  <h1>quiescent demos</h1>
  <p class="lead">
    Two shapes of site built on the same packages, running against an in-memory
    draft store and a stubbed forge — no OAuth app, no token, no repo. Edits
    really do round-trip through <code>flushDrafts</code> into a commit.
  </p>

  <ul class="demos">
    <li>
      <a href="/demo/blog" data-testid="demo-blog">Astro blog</a>
      <p>Posts in a content directory, edited in the browser and committed back.</p>
    </li>
    <li>
      <a href="/demo/wiki" data-testid="demo-wiki">Astro wiki</a>
      <p>
        Wikilinks, tag browsing, client-side search, and a note graph from
        <code>@quiescent/wiki</code>.
      </p>
    </li>
  </ul>
</Layout>

<style>
  .lead {
    max-width: 46rem;
  }
  .demos {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .demos a {
    font-size: 1.1rem;
    font-weight: 600;
  }
  .demos p {
    margin: 0.25rem 0 0;
    opacity: 0.75;
  }
</style>
