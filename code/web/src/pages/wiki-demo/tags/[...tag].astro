---
import { tags } from "virtual:quiescent-wiki";
import Layout from "../../../layouts/Layout.astro";

const tag = Astro.params.tag!;
const notes = tags[tag];
if (!notes) return new Response("Not found", { status: 404 });
---

<Layout title={`tag: ${tag}`}>
  <h1>#{tag}</h1>
  <ul>
    {notes.map((note) => <li><a href={note.url}>{note.title}</a></li>)}
  </ul>
  <p><a href="/wiki-demo/tags">← all tags</a></p>
</Layout>
