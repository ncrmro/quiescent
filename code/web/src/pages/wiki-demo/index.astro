---
import { notes } from "virtual:quiescent-wiki";
import Layout from "../../layouts/Layout.astro";

const byType = new Map<string, typeof notes>();
for (const note of notes) {
  const type = note.type ?? "other";
  byType.set(type, [...(byType.get(type) ?? []), note]);
}
---

<Layout title="wiki demo">
  <h1>Wiki demo</h1>
  <p>
    Build-time index over the fixture wiki:
    <a href="/wiki-demo/search">search</a> ·
    <a href="/wiki-demo/tags">tags</a> ·
    <a href="/wiki-demo/graph">graph</a>
  </p>
  {
    [...byType.entries()].map(([type, group]) => (
      <section>
        <h2>{type}</h2>
        <ul>
          {group.map((note) => (
            <li>
              {note.title ?? note.basename}
              <small> — {note.relPath}</small>
              {note.tags.length > 0 && <small> · {note.tags.join(", ")}</small>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
