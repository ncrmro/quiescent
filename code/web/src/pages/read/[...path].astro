---
import {env} from 'quiescent:runtime';
import {prepareReader} from '@quiescent/server';
import {writingApp} from '../../writing/app';
import ReaderPage from '../../components/ReaderPage.astro';
const data=await prepareReader(Astro,writingApp(env).service,Astro.params.path?.split('/')[0]);
if(data instanceof Response)return data;
---
