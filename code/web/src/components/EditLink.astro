---
import { env } from "quiescent:runtime";
import { writingAuthor } from "../writing/auth";

interface Props {
  slug: string;
  collection: string;
}
Astro.cache.set(false);
Astro.response.headers.set("Cache-Control", "private, no-store");
const canEdit = await writingAuthor(Astro.request, env);
---

{canEdit && (
  <a class="edit" href={`/${Astro.props.collection}/${encodeURIComponent(Astro.props.slug)}/edit`}>
    Edit
  </a>
)}
