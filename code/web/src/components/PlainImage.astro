---
import type { ImageMetadata } from "astro";

interface Props {
  source?: ImageMetadata;
  src?: string;
  alt: string;
  title?: string;
}
const { source, src, alt, title } = Astro.props;
---

<img
  src={src ?? source?.src}
  width={source?.width}
  height={source?.height}
  alt={alt}
  title={title}
  loading="lazy"
>
