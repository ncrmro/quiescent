---
import { readerPath } from "@quiescent/astro";
import type { PostDraft } from "@quiescent/server";
import { documentMediaUrl, renderDocument } from "@quiescent/server/content";
import EditLink from "./EditLink.astro";

interface Props {
  post: PostDraft | null;
  posts: PostDraft[];
}
const { post, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>{post?.post.title ?? "Stories"}</title>
  </head>
  <body>
    <main>
      {post ? (
  <>
    <nav>
      <a href="/">All stories</a>
      <EditLink server:defer slug={post.post.slug ?? post.post.id} />
    </nav>
    <h1>{post.post.title}</h1>
    {post.post.headerImage && (
      <img
        src={documentMediaUrl(post.post.id, post.post.headerImage, { revision: post.headSha })}
        alt=""
        class="header-image"
      />
    )}
    {post.post.tags?.length ? (
      <ul class="tags" aria-label="Tags">
        {post.post.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    ) : null}
    <p>{post.post.description}</p>
    <Fragment
      set:html={renderDocument(post.post.body, (ref) =>
        documentMediaUrl(
          post.post.id,
          ref.postId ? `/media/${ref.postId}/${ref.assetId}` : ref.assetId,
          { revision: post.headSha },
        ),
      )}
    />
  </>
) : (
  <>
    <h1>Stories</h1>
    {posts.map(({ post, headSha }) => (
      <article>
        <h2>
          <a href={readerPath(post)}>{post.title}</a>
        </h2>
        <p>{post.description}</p>
        {post.headerImage && (
          <img
            src={documentMediaUrl(post.id, post.headerImage, { revision: headSha })}
            alt=""
            class="header-image"
          />
        )}
        {post.tags?.length ? <p class="tags">{post.tags.join(" · ")}</p> : null}
        <EditLink server:defer slug={post.slug ?? post.id} />
      </article>
    ))}
  </>
)}
    </main>
  </body>
</html>
<style is:global>
body {
  max-width: 720px;
  margin: 4rem auto;
  padding: 0 1.5rem;
  font:
    19px / 1.7 Georgia,
    serif;
  color: #293530;
  background: #faf9f6;
}
h1,
h2 {
  line-height: 1.2;
}
a {
  color: #315c4c;
}
nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.edit {
  display: inline-block;
  padding: 0.25rem 0.85rem;
  border: 1px solid #bac7be;
  border-radius: 6px;
  text-decoration: none;
  font:
    16px / 1.6 system-ui,
    sans-serif;
}
img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
}
.header-image {
  width: 100%;
  max-height: 420px;
  object-fit: cover;
}
.tags {
  display: flex;
  gap: 0.75rem;
  list-style: none;
  padding: 0;
  font: 14px system-ui;
  color: #59655d;
}
blockquote {
  border-left: 3px solid #b4c4b4;
  padding-left: 1em;
}
</style>
