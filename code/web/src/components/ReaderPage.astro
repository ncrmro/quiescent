---
import { env } from "quiescent:runtime";
import DocumentBody from "@quiescent/astro/components/DocumentBody.astro";
import DocumentImage from "@quiescent/astro/components/DocumentImage.astro";
import { documentImages } from "@quiescent/astro/images";
import type { DocumentDraft } from "@quiescent/server";
import { fromMarkdown } from "@quiescent/server/content";
import { writingApp } from "../writing/app";
import { type Collection, documentPath, type ExampleMetadata } from "../writing/collections";
import EditLink from "./EditLink.astro";
import PlainImage from "./PlainImage.astro";
import SiteNav from "./SiteNav.astro";

interface Props {
  collection: Collection;
  post: DocumentDraft<ExampleMetadata> | null;
  posts: DocumentDraft<ExampleMetadata>[];
}
const { post, posts, collection } = Astro.props;
const { service } = writingApp(env, collection);
const imageSets = new Map<string, Awaited<ReturnType<typeof documentImages>>>();
for (const draft of posts)
  imageSets.set(
    draft.document.id,
    await documentImages(
      draft,
      post
        ? service.references(draft.document)
        : draft.document.frontmatter.headerImage
          ? [draft.document.frontmatter.headerImage]
          : [],
      service.readMedia,
    ),
  );
let body: ReturnType<typeof fromMarkdown> | undefined;
if (post) {
  try {
    body = fromMarkdown(post.document.body);
  } catch {
    /* Preserve unsupported Markdown as escaped source. */
  }
}
const images = post ? imageSets.get(post.document.id)! : {};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>{post?.document.frontmatter.title ?? "Stories"}</title>
  </head>
  <body class="reader-page">
    <SiteNav collection={collection} />
    <main>
      {post ? (
  <>
    <nav>
      <a href="/">All stories</a>
      <EditLink server:defer collection={collection} documentId={post.document.id} />
    </nav>
    <h1>{post.document.frontmatter.title}</h1>
    {post.document.frontmatter.headerImage && images[post.document.frontmatter.headerImage] && (
      <DocumentImage
        source={images[post.document.frontmatter.headerImage]!}
        alt=""
        class="header-image"
        priority
      />
    )}
    {post.document.frontmatter.tags?.length ? (
      <ul class="tags" aria-label="Tags">
        {post.document.frontmatter.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    ) : null}
    <p>{post.document.frontmatter.description}</p>
    {collection === "recipes" && (
      <section>
        <p>Preparation: {String(post.document.frontmatter.preparationMinutes ?? 0)} minutes</p>
        <h2>Ingredients</h2>
        <pre>{JSON.stringify(post.document.frontmatter.ingredients ?? [], null, 2)}</pre>
      </section>
    )}
    {body ? (
      <DocumentBody
        node={body}
        images={images}
        imageComponent={collection === "recipes" ? PlainImage : DocumentImage}
      />
    ) : (
      <pre>{post.document.body}</pre>
    )}
  </>
) : (
  <>
    <h1>{collection === "posts" ? "Stories" : "Recipes"}</h1>
    {posts.map(({ document }, index) => (
      <article>
        <h2>
          <a href={documentPath(collection, document)}>{document.frontmatter.title}</a>
        </h2>
        <p>{document.frontmatter.description}</p>
        {document.frontmatter.headerImage &&
          imageSets.get(document.id)?.[document.frontmatter.headerImage] && (
            <DocumentImage
              source={imageSets.get(document.id)![document.frontmatter.headerImage]!}
              alt=""
              class="header-image"
              priority={index === 0}
            />
          )}
        {document.frontmatter.tags?.length ? (
          <p class="tags">{document.frontmatter.tags.join(" · ")}</p>
        ) : null}
        <EditLink server:defer collection={collection} documentId={document.id} />
      </article>
    ))}
  </>
)}
    </main>
  </body>
</html>
<script>
import { wireNewLinks } from "../writing/navigation";

wireNewLinks();
</script>
<style is:global>
body.reader-page {
  & {
    max-width: 720px;
    margin: 4rem auto;
    padding: 0 1.5rem;
    font:
      19px / 1.7 Georgia,
      serif;
    color: #293530;
    background: #faf9f6;
  }
  h1,
  h2 {
    line-height: 1.2;
  }
  a {
    color: #315c4c;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .edit {
    display: inline-block;
    padding: 0.25rem 0.85rem;
    border: 1px solid #bac7be;
    border-radius: 6px;
    text-decoration: none;
    font:
      16px / 1.6 system-ui,
      sans-serif;
  }
  img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .header-image {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
  }
  .tags {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    font: 14px system-ui;
    color: #59655d;
  }
  blockquote {
    border-left: 3px solid #b4c4b4;
    padding-left: 1em;
  }
}
</style>
