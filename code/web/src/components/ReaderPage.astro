---
import {readerPath,type PostDraft} from '@quiescent/server';
import {renderDocument} from '@quiescent/editor/document';
import EditLink from './EditLink.astro';
interface Props {post:PostDraft|null;posts:PostDraft[]}
const {post,posts}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{post?.post.title ?? 'Stories'}</title></head>
<body><main>
{post ? <><nav><a href="/read">All stories</a><EditLink server:defer slug={post.post.slug ?? post.post.id}/></nav><h1>{post.post.title}</h1><p>{post.post.description}</p><Fragment set:html={renderDocument(post.post.body)}/></> : <><h1>Stories</h1>{posts.map(({post})=><article><h2><a href={readerPath(post)}>{post.title}</a></h2><p>{post.description}</p><EditLink server:defer slug={post.slug ?? post.id}/></article>)}</>}
</main></body></html>
<style is:global>body{max-width:720px;margin:4rem auto;padding:0 1.5rem;font:19px/1.7 Georgia,serif;color:#293530;background:#faf9f6}h1,h2{line-height:1.2}a{color:#315c4c}nav{display:flex;align-items:center;justify-content:space-between}.edit{display:inline-block;padding:.25rem .85rem;border:1px solid #bac7be;border-radius:6px;text-decoration:none;font:16px/1.6 system-ui,sans-serif}img{max-width:100%;height:auto;border-radius:8px}blockquote{border-left:3px solid #b4c4b4;padding-left:1em}</style>
