{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiescent-writing-test",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "590b288a3fd54ac2a7ec2699545153c5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WRITING_MEDIA",
      "bucket_name": "quiescent-writing-demo-images"
    }
  ],
  "vars": {
    "WRITING_REPO_OWNER": "ncrmro",
    "WRITING_REPO_NAME": "quiescent-writing-demo",
    "WRITING_AUTHOR_NAME": "Nicholas Romero",
    "WRITING_AUTHOR_EMAIL": "ncrmro@users.noreply.github.com",
    "WRITING_R2_BUCKET": "quiescent-writing-demo-images",
    "WRITING_TEST": "true"
  },
  "observability": {
    "enabled": true
  },
  "account_id": "cd7618208c116e5b6947e6cc0d02b53f",
  "workers_dev": true,
  "preview_urls": false
}
