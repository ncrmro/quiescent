---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  source: ImageMetadata;
  alt: string;
  title?: string;
  priority?: boolean;
  class?: string;
}
const { source, alt, title, priority = false, class: className } = Astro.props;
---

<Image
  src={source}
  alt={alt}
  title={title}
  class={className}
  width={Math.min(source.width, 720)}
  widths={[360, 720, 1080, 1440]}
  sizes="(max-width: 768px) calc(100vw - 48px), 720px"
  layout="constrained"
  format="webp"
  quality={80}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
/>
