{
  "name": "@quiescent/astro",
  "version": "0.1.0",
  "type": "module",
  "description": "Astro route helpers, page caching, and publication warming for Quiescent",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./components/*": "./components/*"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "components"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@quiescent/server": "^0.3.0"
  },
  "peerDependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncrmro/quiescent.git",
    "directory": "code/astro"
  },
  "publishConfig": {
    "access": "public"
  }
}
